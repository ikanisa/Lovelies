{
  "$schema":"node_modules/wrangler/config-schema.json",
  "account_id":"2209b915a85b1c11cee79b7806c6e73b",
  "name":"lovelies-supabase-inference",
  "main":"src/supabase-inference.ts",
  "compatibility_date":"2026-07-21",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "preview_urls":false,
  "send_metrics":false,
  "logpush":false,
  "observability":{"enabled":false,"head_sampling_rate":0,"logs":{"enabled":false,"invocation_logs":false,"persist":false},"traces":{"enabled":false,"persist":false}},
  // Select the immutable inference artifact directly. This configuration does
  // not build an image or represent security/recognition acceptance. The
  // packaging-only d815 candidate moves the proven empty layer first while
  // retaining the exact 982e payload/runtime; provider unpack is a real gate.
  "containers":[{
    "class_name":"SupabaseInferenceContainer",
    "image":"registry.cloudflare.com/2209b915a85b1c11cee79b7806c6e73b/lovelies-inference-native@sha256:d815c57f43cb4f1e26d624e68d8b5f43db5a76723e1c1de8d88a341273b68ffe",
    "scheduling_policy":"default",
    "instance_type":{"vcpu":1,"memory_mib":3072,"disk_mb":8000},
    "max_instances":1,
    "constraints":{"jurisdiction":"eu","regions":["WEUR"]},
    "ssh":{"enabled":false}
  }],
  "durable_objects":{"bindings":[{"name":"ML_SUPABASE_CONTAINER","class_name":"SupabaseInferenceContainer"}]},
  "migrations":[{"tag":"lovelies-supabase-inference-v1","new_sqlite_classes":["SupabaseInferenceContainer"]}]
}

    "start": "node src/server.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "4.20260714.0",
    "wrangler": "4.112.0",
    "@electric-sql/pglite": "0.3.14"
  },
  "dependencies": {
    "postgres": "3.4.7"
  }
}

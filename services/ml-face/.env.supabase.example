# Server-only HTTPS deployment behind TLS. The Python listener itself stays on
# the private container network; do not expose an unauthenticated direct port.
ML_DEPLOYMENT_TRANSPORT=https_service
ML_INFERENCE_SECRET=
ML_USE_DETERMINISTIC_SIMULATOR=false
ML_REQUIRE_MODEL_ARTIFACTS=true
ML_DEPLOYMENT_MODE=fully_evaluated
# This new reference space currently fails closed in fully_evaluated mode. A
# preserved old-engine report cannot qualify it. Use explicit monitored_pilot
# only for an authorized isolated qualification, with current purpose consent.
ML_EVALUATION_REPORT_PATH=
FACE_AUTH_MAX_COSINE_DISTANCE=0.35

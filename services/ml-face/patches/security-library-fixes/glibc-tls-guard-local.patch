+/* Anonymous thread mappings use allocation-free kernel randomness.  A hint
+   is accepted only at the selected address; an occupied hint must not fall
+   back to the deterministic kernel search area.  Never use MAP_FIXED.  */
+static void *
+thread_mapping (size_t size, int prot, int extra_flags)
+{
+#if !defined __x86_64__ || !TLS_TCB_AT_TP || !_STACK_GROWS_DOWN
+# error This local thread storage profile requires Linux x86_64 TLS_TCB_AT_TP
+#endif
+  const uintptr_t low = UINT64_C (0x100000000000);
+  const uintptr_t high = UINT64_C (0x700000000000);
+  size_t page = __getpagesize ();
+  if (size == 0 || size >= high - low || size > SIZE_MAX - (page - 1))
+    { __set_errno (ENOMEM); return MAP_FAILED; }
+  size_t rounded = (size + page - 1) & ~(page - 1);
+  uintptr_t slots = (high - low - rounded) / page + 1;
+  for (unsigned int attempt = 0; attempt < 64; ++attempt)
+    {
+      uint64_t random_value;
+      size_t have = 0;
+      while (have < sizeof random_value)
+        {
+          long n = INTERNAL_SYSCALL_CALL (getrandom,
+              (char *) &random_value + have, sizeof random_value - have, 0);
+          if (INTERNAL_SYSCALL_ERROR_P (n))
+            {
+              int error = INTERNAL_SYSCALL_ERRNO (n);
+              if (error == EINTR) continue;
+              __set_errno (error);
+              return MAP_FAILED;
+            }
+          if (n == 0) { __set_errno (EIO); return MAP_FAILED; }
+          have += n;
+        }
+      void *hint = (void *) (low + (random_value % slots) * page);
+      void *mapped = __mmap (hint, rounded, prot,
+          MAP_PRIVATE | MAP_ANONYMOUS | extra_flags, -1, 0);
+      if (mapped == hint) return mapped;
+      if (mapped != MAP_FAILED) __munmap (mapped, rounded);
+      else if (errno != ENOMEM && errno != EAGAIN)
+        return MAP_FAILED;
+    }
+  __set_errno (ENOMEM);
+  return MAP_FAILED;
+}

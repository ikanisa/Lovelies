+/* Keep the static TLS/TCB ABI intact, in an independently owned mapping
+   with inaccessible pages on both sides.  Caller stack memory is untouched;
+   the lower stack guard setting does not disable TLS isolation.  */
+static int
+thread_descriptor (size_t tls_size, size_t align_mask, struct pthread **out)
+{
+  size_t page = __getpagesize ();
+  if (tls_size > SIZE_MAX - align_mask - (page - 1) - 2 * page)
+    return EINVAL;
+  size_t payload = (tls_size + align_mask + page - 1) & ~(page - 1);
+  size_t total = payload + 2 * page;
+  void *block = thread_mapping (total, PROT_NONE, 0);
+  if (block == MAP_FAILED) return errno;
+  if (__mprotect ((char *) block + page, payload, PROT_READ | PROT_WRITE))
+    {
+      int error = errno;
+      __munmap (block, total);
+      return error;
+    }
+  struct pthread *pd = (struct pthread *)
+      ((((uintptr_t) block + page + payload) - TLS_TCB_SIZE) & ~align_mask);
+  assert ((char *) pd - tls_size + TLS_TCB_SIZE >= (char *) block + page);
+  pd->tls_stackblock = block;
+  pd->tls_stackblock_size = total;
+  *out = pd;
+  return 0;
 }
 

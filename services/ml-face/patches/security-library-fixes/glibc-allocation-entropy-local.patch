-/* If we don't have the main arena, then maybe the failure is due to running
-   out of mmapped areas, so we can try allocating on the main arena.
-   Otherwise, it is likely that sbrk() has failed and there is still a chance
-   to mmap(), so try one of the other arenas.  */
+  (void) size;
+  (void) avoid_arena;
+  assert (thread_arena == NULL || thread_arena == &main_arena);
+
+  /* Keep the existing arena-before-free-list lock order.  Retry callers
+     have released their current arena lock before entering here. */
+  __libc_lock_lock (main_arena.mutex);
+  if (thread_arena != &main_arena)
+    {
+      __libc_lock_lock (free_list_lock);
+      remove_from_free_list (&main_arena);
+      ++main_arena.attached_threads;
+      thread_arena = &main_arena;
+      __libc_lock_unlock (free_list_lock);
+    }
+
+  return &main_arena;
+}

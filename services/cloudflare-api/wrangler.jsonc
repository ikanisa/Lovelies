{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lovelies-cloudflare-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_ENV": "local",
    "FACE_AUTH_POLICY_VERSION": "registered-face-opencv-v1",
    "PHOTO_MODEL_VERSION": "opencv-yunet-sface-2021dec-v1",
    "PHOTO_CONSENT_POLICY_VERSION": "photo-policy-v1",
    "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://localhost:8765",
    "PUBLIC_APP_BASE_URL": "http://127.0.0.1:8765"
  },
  "durable_objects": {
    "bindings": [{ "name": "LOVELIES_CORE", "class_name": "LoveliesCore" }]
  },
  "migrations": [{ "tag": "lovelies-core-v1", "new_sqlite_classes": ["LoveliesCore"] }],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "lovelies-cloudflare-photos" },
    { "binding": "QUARANTINE", "bucket_name": "lovelies-cloudflare-quarantine" },
    { "binding": "PRIVACY_EXPORTS", "bucket_name": "lovelies-cloudflare-privacy-exports" }
  ],
  "services": [
    { "binding": "FACE_AUTH_VERIFIER", "service": "lovelies-private-ml", "entrypoint": "FaceVerifier" },
    { "binding": "PHOTO_PROCESSOR", "service": "lovelies-private-ml", "entrypoint": "PhotoProcessor" }
  ],
  "queues": {
    "producers": [{ "binding": "PHOTO_JOBS", "queue": "lovelies-cloudflare-processing" }],
    "consumers": [{ "queue": "lovelies-cloudflare-processing", "max_batch_size": 5 }]
  }
}

# Local signing keys are generated by pnpm backend:dev; no donor credentials.
AUTH_SIGNING_SECRET=
MEDIA_SIGNING_SECRET=
# Canonical private model Worker service bindings are in wrangler.jsonc.
# Authentication policy is registered-face comparison; no OTP or liveness.
# Optional stores require explicitly owned app/product identities and provider
# credentials. Missing configuration cannot grant original-download entitlement.
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_SUBSCRIPTION_PRODUCT_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

{
  "name": "@lovelies/cloudflare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir ../../verification/cloudflare-native-port/worker-build",
    "test": "pnpm test:unit && pnpm test:runtime",
    "test:unit": "vitest run test/*.test.ts",
    "test:runtime": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "esbuild": "0.28.1",
    "miniflare": "4.20260714.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.112.0"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  }
}
